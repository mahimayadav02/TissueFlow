# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

# Neon connection string WITH connection pooling (has "-pooler" in the host). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon connection string WITHOUT pooling. Used only to create and change tables (migrations).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Port the API listens on, and the website address allowed to call it (comma-separated for more than one).
PORT=4000
CORS_ORIGIN="http://localhost:5173"
