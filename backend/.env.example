# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

# Neon connection string WITH connection pooling (has "-pooler" in the host). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Neon connection string WITHOUT pooling. Used only to create and change tables (migrations).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Port the API listens on, and the website address allowed to call it (comma-separated for more than one).
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Secret for signing sign-in tokens. Make one with:  openssl rand -hex 32
JWT_SECRET=""
# Website address, used in the password reset email link
APP_URL="http://localhost:5173"
# Optional: Resend (resend.com) key for real emails. Leave empty to print reset links in the terminal.
RESEND_API_KEY=""
MAIL_FROM="TissueFlow <onboarding@resend.dev>"
